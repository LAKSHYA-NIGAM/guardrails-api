{
  "name": "guardrails-server",
  "version": "1.0.0",
  "description": "Stateless Guardrails microservice converted to Node.js / Express / Mongoose / Redis",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test tests/unit/**/*.test.js",
    "test:integration": "node --test tests/guardrails.test.js",
    "loadtest": "node ../loadtest/load-runner.js"
  },
  "dependencies": {
    "@upstash/redis": "^1.39.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "node-cron": "^3.0.3"
  }
}
